# =====================================================================
#  My Planner - .gitignore
#  فایل‌ها و پوشه‌هایی که نباید در Git (و GitHub) منتشر شوند.
# =====================================================================

# --- محیط مجازی پایتون ---
.venv/
venv/
env/
ENV/

# --- فایل‌های موقت و کش پایتون ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- دیتابیس (حاوی اطلاعات شخصی کاربر - نباید منتشر شود) ---
backend/planner.db
*.db
*.sqlite
*.sqlite3

# --- نسخه‌های پشتیبان دیتابیس ---
backups/
*.db.bak

# --- متغیرهای محیطی و اطلاعات محرمانه ---
.env
.env.*
*.key
*.pem

# --- تنظیمات ویرایشگر و سیستم‌عامل ---
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini

# --- خروجی‌های ساخت و بسته‌بندی ---
dist/
build/
release/
python/
*.zip
